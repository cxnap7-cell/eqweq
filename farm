-- ==================== 自动化循环 ====================
local function RunQAAgent(intervalMin: number, intervalMax: number, maxActions: number)
    QAState.Status = "Running"
    QAState.StartTime = os.clock()
    AddLog("START", `QA agent started (interval: {intervalMin}-{intervalMax}s, max: {maxActions})`)

    for i = 1, maxActions do
        -- 检查停止条件
        if QAState.Status ~= "Running" then
            AddLog("STOP", "Agent stopped by user")
            break
        end

        -- 执行采集动作
        local success, err = TryCollectEgg()
        QAState.ActionCount += 1

        if success then
            AddLog("COLLECT", `Action {i} succeeded`)
        else
            AddLog("COLLECT", `Action {i} failed: {err}`)
        end

        -- 随机间隔（模拟人类行为）
        local waitTime = math.random() * (intervalMax - intervalMin) + intervalMin
        task.wait(waitTime)

        -- 检查是否超过持续时间
        if os.clock() - QAState.StartTime > Config.Duration then
            AddLog("TIMEOUT", "Duration limit reached")
            break
        end
    end

    QAState.Status = "Stopped"
    AddLog("STOP", `Agent finished. Total actions: {QAState.ActionCount}`)
end

-- ==================== 停止接口 ====================
local function StopQAAgent()
    if QAState.Status == "Running" then
        QAState.Status = "Stopped"
        AddLog("STOP", "Stop requested")
    end
end
