--- Atualiza o texto de status exibido na UI
--- @param text string
local function UpdateStatus(text)
    State.Status = text
    if State.UI.StatusLabel then
        State.UI.StatusLabel.Text = "Status: " .. text
    end
end

--- Cria um efeito de tween suave para qualquer propriedade de Instance
--- @param instance Instance
--- @param goal table
--- @param time number|nil
--- @return Tween
local function SmoothTween(instance, goal, time)
    time = time or 0.25
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(instance, tweenInfo, goal)
    tween:Play()
    return tween
end

-- ==================== LÓGICA DE ROUBO DE OVO ====================

--- Tenta roubar o ovo correspondente ao bioma atual
--- @param biomeKey string
--- @return string|nil Nome do ovo roubado, ou nil se falhar
local function TryStealEgg(biomeKey)
    local biomeData = BIOME_EGG_MAP[biomeKey]
    if not biomeData then
        warn("[AutoEgg] Bioma inválido: " .. tostring(biomeKey))
        return nil
    end

    -- ============================================================
    -- SUBSTITUA ESTE BLOCO PELA LÓGICA REAL DE ROUBO DE OVO DO JOGO
    -- Por exemplo:
    --   local remote = ReplicatedStorage:FindFirstChild("StealEgg")
    --   if remote then
    --       remote:FireServer(eggInstance)
    --   end
    -- ============================================================

    -- Simulação: encontra o primeiro ovo que corresponde ao filtro de raridade
    -- No jogo real, você precisa percorrer os ovos no Workspace ou usar uma API do jogo
    local selectedEgg = nil

    for _, eggName in ipairs(biomeData.eggs) do
        -- Verifica se o ovo corresponde a alguma raridade selecionada pelo usuário
        -- Aqui é necessário determinar a raridade de cada ovo de acordo com a lógica do jogo
        -- O exemplo abaixo assume que o nome do ovo contém a raridade (apenas para demonstração)
        local eggRarity = "Secret" -- Substitua pela lógica real de obtenção de raridade

        if State.RarityFilters[eggRarity] then
            selectedEgg = eggName
            break
        end
    end

    return selectedEgg
end

--- Obtém a raridade correspondente com base no nome do ovo
--- @param eggName string
--- @return string|nil
local function GetEggRarity(eggName)
    -- ============================================================
    -- IMPLEMENTE AQUI A LÓGICA REAL DE OBTENÇÃO DE RARIDADE
    -- Pode ser através de:
    --   1. Ler o atributo do ovo: egg:GetAttribute("Rarity")
    --   2. Buscar em um dicionário na nuvem do jogo
    --   3. Inferir a partir do nome do ovo
    -- ============================================================

    -- Exemplo: inferir a partir do nome
    if eggName:find("Divine") or eggName:find("ArchAngel") or eggName:find("Unicorn") then
        return "Divine"
    elseif eggName:find("Eternal") or eggName:find("Pegasus") or eggName:find("Ice Dragon") then
        return "Eternal"
    elseif eggName:find("Secret") or eggName:find("Kitsune") then
        return "Secret"
    end
    return nil
end

-- ==================== LOOP DE AUTOMAÇÃO ====================

local autoFarmThread = nil

--- Inicia o loop de automação
local function StartAutoFarm()
    if State.IsRunning then return end
    State.IsRunning = true
    UpdateStatus("Procurando ovo...")

    autoFarmThread = task.spawn(function()
        while State.IsRunning do
            local biomeKey = State.SelectedBiome
            local eggName = TryStealEgg(biomeKey)

            if eggName then
                local rarity = GetEggRarity(eggName)
                UpdateStatus("Ovo encontrado: " .. eggName .. " (" .. (rarity or "?") .. ")")
            else
                UpdateStatus("Nenhum ovo correspondente encontrado no bioma atual")
            end

            -- Aguarda antes da próxima tentativa para evitar chamadas excessivas
            -- Ajuste com base no cooldown real do jogo
            task.wait(2)
        end
    end)
end

--- Para o loop de automação
local function StopAutoFarm()
    State.IsRunning = false
    if autoFarmThread then
        task.cancel(autoFarmThread)
        autoFarmThread = nil
    end
    UpdateStatus("Operação interrompida")
end

